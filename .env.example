# ActionTracker Configuration

# Database
DATABASE_PATH=./data/action_tracker.db

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS
CORS_ORIGINS=*

# Privacy
PRIVACY_ENABLED=true
PRIVACY_MASKED_SERVICES=bank,securities,finance,password,vault,1password,bitwarden,lastpass

# Data Retention
RETENTION_DAYS=90

# Tracker
TRACKER_INTERVAL_SECONDS=2
IDLE_THRESHOLD_MINUTES=15
SHORT_SWITCH_THRESHOLD_SECONDS=30

# Scoring
FOCUS_CATEGORIES=開発,学習
DISTRACT_CATEGORIES=娯楽,SNS
INVESTIGATION_SERVICES=GitHub,StackOverflow,Google

# Environment
ENVIRONMENT=development
DEBUG=true

# Security
API_KEY=dev_api_key_change_in_production
SECRET_KEY=change_this_secret_key_in_production

